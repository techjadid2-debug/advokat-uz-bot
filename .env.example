# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Webhook'ni himoyalash uchun tasodifiy satr (Telegram har so'rovda qaytaradi)
TELEGRAM_WEBHOOK_SECRET=
# Bot ochiq domeni, masalan https://bot.advokat.uz
PUBLIC_URL=

# ─── Gemini ───────────────────────────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=
# Bepul 1-savol va tasnif uchun — arzon va tez
GEMINI_MODEL_FAST=gemini-flash-latest
# Pullik savollar va hujjat qoralamasi uchun — chuqurroq
GEMINI_MODEL_DEEP=gemini-pro-latest
# Pinlangan muqobillar: gemini-3.7-flash, gemini-3.5-flash, gemini-2.5-flash,
#                       gemini-3.1-pro-preview, gemini-2.5-pro

# ─── Zaxira provayder (Gemini safety filtri bloklaganda) ──────────────────────
# Bo'sh qoldirilsa, bloklangan savol to'g'ridan-to'g'ri advokat navbatiga tushadi
ANTHROPIC_API_KEY=
FALLBACK_MODEL=claude-sonnet-5

# ─── Baza va navbat ───────────────────────────────────────────────────────────
DATABASE_URL=postgres://advokat:advokat@localhost:5432/advokat
REDIS_URL=redis://localhost:6379

# ─── Admin panel ──────────────────────────────────────────────────────────────
# `openssl rand -base64 32` bilan yarating
AUTH_SECRET=
# Birinchi admin (seed skripti shu bilan yaratadi)
SEED_ADMIN_EMAIL=admin@advokat.uz
SEED_ADMIN_PASSWORD=

# ─── Muhit ────────────────────────────────────────────────────────────────────
NODE_ENV=development
